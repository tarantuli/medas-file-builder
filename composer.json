{
    "name": "morphp/medas-file-builder",
    "description": "Medas file builder",
    "authors": [
        {
            "name": "Patrick Morpey",
            "email": "patrick@morphp.nl"
        }
    ],
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "morphp/medas-service-manager": "@dev",
        "morphp/medas-php-formatter": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../service-manager"
        },
        {
            "type": "path",
            "url": "../php-formatter"
        },
        {
            "type": "path",
            "url": "../config-manager"
        },
        {
            "type": "path",
            "url": "../file-system"
        }
    ],
    "autoload": {
        "psr-4": {
            "Medas\\FileBuilder\\": "src/",
            "Medas\\Test\\": "tests/"
        }
    }
}
